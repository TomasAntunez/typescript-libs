{
  "name": "@chuli-dev/eslint-config",
  "version": "3.1.1",
  "type": "module",
  "description": "Self-contained ESLint flat-config presets for modern TypeScript projects",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "presets",
    "typescript"
  ],
  "author": "chuli-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomasAntunez/typescript-libs.git",
    "directory": "libs/eslint-config"
  },
  "homepage": "https://github.com/TomasAntunez/typescript-libs/tree/main/libs/eslint-config",
  "bugs": {
    "url": "https://github.com/TomasAntunez/typescript-libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint:check": "eslint . --max-warnings 0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@chuli-dev/typescript-config": "*",
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": ">=17",
    "eslint-plugin-simple-import-sort": ">=12",
    "eslint-plugin-unused-imports": ">=4",
    "globals": ">=16",
    "typescript-eslint": ">=8"
  },
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": ">=10",
    "eslint-plugin-n": ">=17",
    "eslint-plugin-simple-import-sort": ">=12",
    "eslint-plugin-unused-imports": ">=4",
    "globals": ">=16",
    "typescript": ">=5",
    "typescript-eslint": ">=8"
  },
  "sideEffects": false
}
